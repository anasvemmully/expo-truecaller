{
  "name": "@anasvemmully/expo-truecaller",
  "version": "0.2.0",
  "description": "Truecaller integration for Expo",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "!build/**/__tests__",
    "plugin/build",
    "android",
    "!android/build",
    "!android/.gradle",
    "!android/.idea",
    "!android/local.properties",
    "ios",
    "app.plugin.js",
    "expo-module.config.json"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js",
    "docs": "typedoc",
    "test:ci": "jest --ci",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-truecaller",
    "ExpoTruecaller"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anasvemmully/expo-truecaller.git"
  },
  "bugs": {
    "url": "https://github.com/anasvemmully/expo-truecaller/issues"
  },
  "author": "Muhammed Anas <anasvemmully@gmail.com> (https://github.com/anasvemmully)",
  "license": "MIT",
  "homepage": "https://github.com/anasvemmully/expo-truecaller#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@expo/config-plugins": "^58.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.26",
    "eslint": "~9.39.5",
    "eslint-config-universe": "^15.0.3",
    "expo": "~58.0.26",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "react": "^19.3.0",
    "react-native": "^0.88.1",
    "react-test-renderer": "^19.3.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/plugin/src"
    ]
  },
  "peerDependencies": {
    "expo": ">=57 <59",
    "react": ">=19.2 <20",
    "react-native": ">=0.86 <0.89"
  }
}
